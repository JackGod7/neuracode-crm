# Neuracode CRM — Variables de Entorno
# Copia como .env.local: cp .env.example .env.local

# ─── AI ────────────────────────────────────────────────────────────────────────
# ANTHROPIC_API_KEY=sk-ant-...
# AGENT_BUSINESS_PROMPT=   # System prompt del agente WA. Opcional: usa default si vacío.

# ─── Email digest ──────────────────────────────────────────────────────────────
# RESEND_API_KEY=re_...
# DIGEST_EMAIL=tu@email.com
# DIGEST_FROM=Neuracode CRM <onboarding@resend.dev>

# ─── Meta / WhatsApp Business ──────────────────────────────────────────────────
# META_PHONE_NUMBER_ID=          # ID del número en Meta (no el número en sí)
# META_WABA_ID=                  # WhatsApp Business Account ID
# META_PHONE_NUMBER=             # Número real en E.164 (ej: +51997055975)
# META_ACCESS_TOKEN=             # Token de sistema permanente (no el temporal de 24h)
# META_APP_SECRET=               # Para validar firma X-Hub-Signature-256 en webhooks
# META_VERIFY_TOKEN=             # Token propio para verificar webhook (inventado por ti)

# ─── Retell Voice (Track 2) ─────────────────────────────────────────────────────
# RETELL_API_KEY=
# RETELL_WEBHOOK_SECRET=

# ─── Twilio HIPAA (Track 2) ─────────────────────────────────────────────────────
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=

# ─── Backend ───────────────────────────────────────────────────────────────────
# NET_API_URL=http://localhost:5000
