{
  "env": {
    "CLAUDE_CODE_AUTO_COMPACT_WINDOW": "400000"
  },
  "permissions": {
    "allow": [
      "Bash(dotnet:*)",
      "Bash(dotnet new:*)",
      "Bash(dotnet build:*)",
      "Bash(dotnet test:*)",
      "Bash(dotnet run:*)",
      "Bash(dotnet ef:*)",
      "Bash(dotnet add:*)",
      "Bash(dotnet restore:*)",
      "Bash(dotnet publish:*)",
      "Bash(dotnet tool:*)",
      "Bash(dotnet format:*)",
      "Bash(dotnet sln:*)",
      "Bash(npm run dev:*)",
      "Bash(npm run build:*)",
      "Bash(npm run start:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run seed:*)",
      "Bash(npm run init:*)",
      "Bash(npm run local:*)",
      "Bash(npm run mcp:*)",
      "Bash(npm install:*)",
      "Bash(npm uninstall:*)",
      "Bash(npm test:*)",
      "Bash(npx drizzle-kit:*)",
      "Bash(npx tsx:*)",
      "Bash(npx playwright:*)",
      "Bash(git:*)",
      "Bash(gh:*)",
      "Bash(curl:*)",
      "Bash(ls:*)",
      "Bash(mkdir:*)",
      "Bash(node:*)",
      "Bash(cat:*)",
      "Bash(head:*)",
      "Bash(wc:*)",
      "Bash(docker compose:*)",
      "Bash(docker build:*)",
      "Bash(docker run:*)",
      "Bash(docker logs:*)",
      "Bash(docker ps:*)",
      "Bash(sqlite3:*)",
      "Bash(rtk:*)",
      "Bash(railway:*)",
      "Bash(ssh:*)",
      "Bash(python3:*)",
      "Bash(python:*)",
      "Read(./**)",
      "Write(./**)",
      "Edit(./**)",
      "Glob(./**)",
      "Grep(./**)",
      "WebSearch",
      "WebFetch(domain:developers.facebook.com)",
      "WebFetch(domain:docs.anthropic.com)",
      "WebFetch(domain:learn.microsoft.com)",
      "WebFetch(domain:railway.app)",
      "WebFetch(domain:github.com)",
      "WebFetch(domain:martinfowler.com)",
      "mcp__context7__resolve-library-id",
      "mcp__context7__query-docs",
      "Bash(echo \"hooksPath set to: $\\(git config core.hooksPath\\)\")"
    ],
    "deny": [
      "Bash(rm -rf:*)",
      "Bash(git push --force:*)",
      "Bash(git reset --hard:*)",
      "Bash(docker system prune:*)",
      "Bash(npm publish:*)",
      "Bash(dotnet nuget push:*)",
      "Write(./.env)",
      "Write(./.env.local)",
      "Write(./data/crm.db)",
      "Read(./.env)",
      "Read(./.env.local)"
    ]
  },
  "enableAllProjectMcpServers": true,
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NonInteractive -File .claude/hooks/format-on-save.ps1"
          },
          {
            "type": "command",
            "command": "powershell -NonInteractive -File .claude/hooks/check-file-size.ps1"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -Command \"if (!(Test-Path 'docs/specs') -or !(Get-ChildItem 'docs/specs' -Recurse -Filter '*.md' -ErrorAction SilentlyContinue)) { Write-Host 'BLOCKED: No spec in docs/specs/. Create SPDD before editing code.'; exit 1 }\""
          }
        ]
      }
    ]
  }
}
