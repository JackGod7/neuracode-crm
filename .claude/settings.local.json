  "enableAllProjectMcpServers": true,
  "enabledMcpjsonServers": [
    "Vercel"
  ],
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -NonInteractive -File .claude/hooks/format-on-save.ps1"
          },
          {
            "type": "command",
            "command": "powershell -NonInteractive -File .claude/hooks/check-file-size.ps1"
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "Edit|Write",
        "hooks": [
          {
            "type": "command",
            "command": "powershell -Command \"if (!(Test-Path 'docs/specs') -or !(Get-ChildItem 'docs/specs' -Recurse -Filter '*.md' -ErrorAction SilentlyContinue)) { Write-Host 'BLOCKED: No spec.md in docs/specs/. Create spec before editing code.'; exit 1 }\""
          }
        ]
      }
    ]
  }
}
